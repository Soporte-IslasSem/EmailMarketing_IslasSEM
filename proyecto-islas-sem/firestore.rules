rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helpers multi-tenant (CRM) =====
    function isSignedIn() {
      return request.auth != null;
    }
    // orgId al que pertenece el usuario actual (según su perfil en /users)
    function myOrg() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
    }
    // ===== Acceso a la app (multiempresa) =====
    // Cada usuario es de una empresa (users/{uid}.orgId, que solo cambia el servidor). Entra
    // quien figura en ella: empleado (Administración › Empleados, memberRoles), lista de acceso
    // (accessEmails, Administración › Sistema › Accesos) o soporte de la plataforma mientras
    // dure (supportEmails hasta supportUntil); con el email verificado (Google lo verifica; con
    // contraseña, el enlace que llega por email) y con la empresa sin suspender.
    function memberOf(org) {
      let email = request.auth.token.email.lower();
      return email in org.get('accessEmails', []) || email in org.get('memberRoles', {})
        || (email in org.get('supportEmails', []) && request.time.toMillis() < org.get('supportUntil', 0));
    }
    function staff() {
      return isSignedIn() && request.auth.token.email_verified == true
        && memberOf(orgData()) && !(orgData().get('status', 'active') in ['suspended', 'deleted']);
    }
    function isMember(orgId) {
      return isSignedIn() && myOrg() == orgId && staff();
    }
    // Un documento del CRM pertenece a la organización del usuario
    function ownDocOrg() {
      return isSignedIn() && resource.data.orgId == myOrg() && staff();
    }
    function createInMyOrg() {
      return isSignedIn() && request.resource.data.orgId == myOrg() && staff();
    }

    // ===== Roles y permisos (Administración › Roles y permisos) =====
    // organizations/{org}: adminEmails (si está vacío, todos son administradores),
    // memberRoles { email: rol } y rolePerms { rol: { entidad: { read, add, edit,
    // delete, export, import } } } con 0 = Denegar, 1 = Propios, 2 = Todo.
    function orgData() {
      return get(/databases/$(database)/documents/organizations/$(myOrg())).data;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOrgAdmin() {
      let admins = orgData().get('adminEmails', []);
      return isSignedIn() && (admins.size() == 0 || myEmail() in admins
        || (myEmail() in orgData().get('supportEmails', []) && request.time.toMillis() < orgData().get('supportUntil', 0)));
    }
    function myRole() {
      return orgData().get('memberRoles', {}).get(myEmail(), '_sinrol');
    }
    function lvl(entity, perm) {
      return isOrgAdmin() ? 2 : orgData().get('rolePerms', {}).get(myRole(), {}).get(entity, {}).get(perm, 2);
    }
    // "Propios": responsable, creador o asignado.
    function isOwn(d) {
      return d.get('ownerEmail', '') == myEmail() || d.get('createdByEmail', '') == myEmail() || d.get('assigneeEmail', '') == myEmail();
    }
    function canOn(entity, perm, d) {
      let l = lvl(entity, perm);
      return l == 2 || (l == 1 && isOwn(d));
    }
    // Lectura: con "Propios" se permite leer la colección (la app filtra lo que muestra);
    // con "Denegar" no se puede leer nada.
    function canRead(entity) {
      return ownDocOrg() && lvl(entity, 'read') > 0;
    }
    function canCreate(entity) {
      return createInMyOrg() && lvl(entity, 'add') > 0;
    }
    function canEdit(entity) {
      return ownDocOrg() && request.resource.data.orgId == resource.data.orgId && canOn(entity, 'edit', resource.data);
    }
    function canDelete(entity) {
      return ownDocOrg() && canOn(entity, 'delete', resource.data);
    }
    // Tipo de cliente y responsable de contactos/empresas: solo administradores.
    function keepsAdminFields() {
      return isOrgAdmin() || !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['clientType', 'clientTypes', 'ownerType', 'ownerId', 'ownerName', 'ownerEmail']);
    }

    // Cada usuario solo puede leer/escribir su propio perfil; la empresa (orgId) la pone el servidor.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && !('orgId' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
      allow delete: if false;
    }

    // ===== Organizaciones (multi-tenant) =====
    function withinSeats(next, prev) {
      return next <= prev || next <= resource.data.get('limits', {}).get('users', 100000);
    }
    match /organizations/{orgId} {
      // Sus miembros pueden leerla aunque esté suspendida (para ver el aviso y pagar).
      allow read: if isSignedIn() && request.auth.token.email_verified == true && myOrg() == orgId && memberOf(orgData());
      allow create, delete: if false; // las altas y bajas de empresas las hace el servidor
      // Accesos, roles, administradores, tipos de cliente e imagen: solo administradores.
      // Plan, estado, módulos, límites, soporte y cobros: solo el servidor.
      allow update: if isMember(orgId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'plan', 'features', 'limits', 'billing',
          'trialEndsAt', 'supportEmails', 'supportUntil', 'flowSince', 'flowLastRun', 'createdAt', 'ownerUid', 'ownerEmail'])
        && (isOrgAdmin() || !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['accessEmails', 'adminEmails', 'memberRoles', 'memberEmails', 'rolePerms', 'roles', 'clientTypes', 'name', 'brand']))
        // Límite de usuarios del plan (limits.users): no se puede añadir a nadie por encima (quitar, sí).
        && withinSeats(request.resource.data.get('accessEmails', []).size(), resource.data.get('accessEmails', []).size())
        && withinSeats(request.resource.data.get('memberRoles', {}).size(), resource.data.get('memberRoles', {}).size());
    }

    // ===== Colecciones del CRM (aisladas por orgId) =====
    match /contacts/{docId} {
      allow read: if canRead('contacts');
      allow create: if canCreate('contacts');
      allow update: if canEdit('contacts') && keepsAdminFields();
      allow delete: if canDelete('contacts');
    }
    match /companies/{docId} {
      allow read: if canRead('companies');
      allow create: if canCreate('companies');
      allow update: if canEdit('companies') && keepsAdminFields();
      allow delete: if canDelete('companies');
    }
    match /leads/{docId} {
      allow read: if canRead('leads');
      allow create: if canCreate('leads');
      allow update: if canEdit('leads');
      allow delete: if canDelete('leads');
    }
    match /deals/{docId} {
      allow read: if canRead('deals');
      allow create: if canCreate('deals');
      allow update: if canEdit('deals');
      allow delete: if canDelete('deals');
    }
    // Embudos: etapas, nombres y reglas de automatización. Solo administradores.
    match /pipelines/{docId} {
      allow read: if ownDocOrg();
      allow update, delete: if ownDocOrg() && isOrgAdmin();
      allow create: if createInMyOrg() && isOrgAdmin();
    }
    match /activities/{docId} {
      allow read, update, delete: if ownDocOrg();
      allow create: if createInMyOrg();
    }
    match /products/{docId} {
      allow read: if canRead('products');
      allow create: if canCreate('products');
      allow update: if canEdit('products');
      allow delete: if canDelete('products');
    }
    match /quotes/{docId} {
      allow read: if canRead('quotes');
      allow create: if canCreate('quotes');
      allow update: if canEdit('quotes');
      allow delete: if canDelete('quotes');
    }
    match /invoices/{docId} {
      allow read: if canRead('invoices');
      allow create: if canCreate('invoices');
      allow update: if canEdit('invoices');
      allow delete: if canDelete('invoices');
    }
    match /outbox/{docId} {
      allow read, update, delete: if ownDocOrg();
      allow create: if createInMyOrg();
    }
    // Envíos de formularios PÚBLICOS: los guarda el servidor (/api/forms/submit, con reCAPTCHA y
    // la empresa del formulario); solo los miembros de esa empresa pueden leerlos/gestionarlos.
    match /formSubmissions/{docId} {
      allow create: if false;
      allow read, update, delete: if ownDocOrg();
    }
    // Formularios creados en CRM › Formularios. La página pública los lee a través del
    // backend (/api/forms/def/:id), así que aquí no hay lectura pública.
    match /crmForms/{docId} {
      allow read, update, delete: if ownDocOrg();
      allow create: if createInMyOrg();
    }
    // Empleados (de aquí salen administradores y roles): solo los administradores los cambian.
    match /employees/{docId} {
      allow read: if ownDocOrg();
      allow update, delete: if ownDocOrg() && isOrgAdmin();
      allow create: if createInMyOrg() && isOrgAdmin();
    }
    match /departments/{docId} {
      allow read, update, delete: if ownDocOrg();
      allow create: if createInMyOrg();
    }
    match /salesteams/{docId} {
      allow read: if ownDocOrg();
      allow update, delete: if ownDocOrg() && isOrgAdmin();
      allow create: if createInMyOrg() && isOrgAdmin();
    }
    match /roles/{docId} {
      allow read, update, delete: if ownDocOrg();
      allow create: if createInMyOrg();
    }
    // Campos personalizados (definiciones por entidad) y Papelera de reciclaje
    // Cualquiera puede crear un campo nuevo ("+ Crear campo"); cambiarlo o quitarlo, solo administradores.
    match /customFields/{docId} {
      allow read: if ownDocOrg();
      allow update, delete: if ownDocOrg() && isOrgAdmin();
      allow create: if createInMyOrg();
    }
    // Restaurantes: fichas de cliente (separado del CRM), compartidas por la organización
    match /restaurants/{docId} {
      allow read, update, delete: if ownDocOrg();
      allow create: if createInMyOrg();
    }
    // Ajustes de Restaurantes (nombre de la marca): un documento por organización
    match /restaurantSettings/{orgId} {
      allow read, write: if isMember(orgId);
    }
    match /recyclebin/{docId} {
      allow read, update, delete: if ownDocOrg();
      allow create: if createInMyOrg();
    }

    // Listas: dueño mediante el campo "userId"
    match /lists/{listId} {
      allow read, update, delete: if staff() && resource.data.userId == request.auth.uid;
      allow create: if staff() && request.resource.data.userId == request.auth.uid;

      // Subcolecciones de una lista: mismo dueño que la lista "padre"
      match /fields/{fieldId} {
        allow read, write: if staff() &&
          get(/databases/$(database)/documents/lists/$(listId)).data.userId == request.auth.uid;
      }

      match /segments/{segmentId} {
        allow read, write: if staff() &&
          get(/databases/$(database)/documents/lists/$(listId)).data.userId == request.auth.uid;
      }
    }

    // Suscriptores: dueño mediante "userId"
    match /subscribers/{subId} {
      allow read, update, delete: if staff() && resource.data.userId == request.auth.uid;
      allow create: if staff() && request.resource.data.userId == request.auth.uid;
    }

    // Campañas: dueño mediante "ownerId" (nombre distinto al resto de colecciones)
    match /campaigns/{campaignId} {
      allow read, update, delete: if staff() && resource.data.ownerId == request.auth.uid;
      allow create: if staff() && request.resource.data.ownerId == request.auth.uid;
    }

    // Plantillas: dueño mediante "userId"
    match /templates/{templateId} {
      allow read, update, delete: if staff() && resource.data.userId == request.auth.uid;
      allow create: if staff() && request.resource.data.userId == request.auth.uid;
    }

    // Formularios: dueño mediante "userId"
    match /forms/{formId} {
      allow read, update, delete: if staff() && resource.data.userId == request.auth.uid;
      allow create: if staff() && request.resource.data.userId == request.auth.uid;
    }

    // Automatizaciones de email marketing: dueño mediante "userId".
    // Las inscripciones (automationEnrollments) solo las toca el backend (Admin SDK).
    match /automations/{automationId} {
      allow read, update, delete: if staff() && resource.data.userId == request.auth.uid;
      allow create: if staff() && request.resource.data.userId == request.auth.uid;
    }

    // Etiquetas de plantillas/campañas: dueño mediante "userEmail"
    match /templateTags/{tagId} {
      allow read, update, delete: if staff() && resource.data.userEmail == request.auth.token.email;
      allow create: if staff() && request.resource.data.userEmail == request.auth.token.email;
    }

    // Colección "tags": código muerto, no se usa desde ninguna pantalla. Bloqueada por defecto.
    match /tags/{tagId} {
      allow read, write: if false;
    }

    // Informes: solo el dueño de la campaña puede leerlos.
    // Los crea únicamente la Cloud Function (Admin SDK), nunca el navegador.
    match /reports/{reportId} {
      allow read: if staff() && resource.data.ownerId == request.auth.uid;
      // Los escribe el servidor; el dueño solo puede ocultarlos ("Eliminar informe").
      allow update: if staff() && resource.data.ownerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'hiddenAt']);
      allow create, delete: if false;
    }

    // ===== WhatsApp (cada empresa en su carpeta: organizations/{orgId}/…) =====
    // La app solo LEE (en tiempo real) los chats y sus mensajes de SU empresa, quien puede ver
    // contactos. Escribir (enviar, asignar, archivar, ligar al contacto) lo hace el servidor.
    // Configuración (embudos, equipos, respuestas rápidas, auto respuestas, chatbot, etiquetas),
    // plantillas de Meta sincronizadas y difusiones: solo lectura; los cambios pasan por el
    // servidor (que comprueba quién es administrador). Los ajustes con el token de Meta están en
    // organizations/{orgId}/private, que nadie lee desde la app.
    function waReader(orgId) {
      return isMember(orgId) && lvl('contacts', 'read') > 0;
    }
    match /organizations/{orgId}/waChats/{chatId} {
      allow read: if waReader(orgId);
      allow write: if false;
      match /messages/{msgId} {
        allow read: if waReader(orgId);
        allow write: if false;
      }
    }
    match /organizations/{orgId}/waConfig/{docId} {
      allow read: if waReader(orgId);
      allow write: if false;
    }
    match /organizations/{orgId}/waTemplates/{docId} {
      allow read: if waReader(orgId);
      allow write: if false;
    }
    match /organizations/{orgId}/waBroadcasts/{docId} {
      allow read: if waReader(orgId);
      allow write: if false;
      match /recipients/{rid} {
        allow read: if waReader(orgId);
        allow write: if false;
      }
    }

    // Todo lo demás, bloqueado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
