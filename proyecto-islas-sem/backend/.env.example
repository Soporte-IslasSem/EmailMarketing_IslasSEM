# === Backend ISLAS SEM — variables de entorno (Plesk) ===
# Copia este archivo como .env y rellena los valores reales EN EL SERVIDOR (nunca en git).

# Puerto (Plesk lo asigna; déjalo o ajústalo si Plesk pide otro)
PORT=3000

# Secreto para proteger el endpoint del cron (invéntate una cadena larga)
CRON_SECRET=pon-aqui-una-cadena-larga-y-secreta

# --- Throttle de envío (email marketing a escala) ---
MAX_PER_RUN=30          # correos por ejecución del cron (cada minuto)
SMTP_DAILY_LIMIT=1800   # tope diario por cuenta (bajo el límite de Gmail ~2000)

# --- Firebase (service account) ---
# Opción A (recomendada): ruta al JSON de la service account subido al servidor
GOOGLE_APPLICATION_CREDENTIALS=/var/www/vhosts/islassem.com/api.islassem.com/serviceAccount.json
# Opción B (alternativa): el JSON entero en una sola variable
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# === Correo vía GOOGLE WORKSPACE de islassem.com (el MX de .com va a Google) ===
# Cuenta: marketing@islassem.com · requiere 2FA + "Contraseña de aplicación" (16 letras).
# La MISMA cuenta envía (SMTP) y recibe/lee (IMAP), así las respuestas caen donde las leemos.

# --- ENVÍO (SMTP de Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=marketing@islassem.com
SMTP_PASSWORD=contraseña-de-aplicación-de-16-letras
SMTP_FROM=ISLAS SEM <marketing@islassem.com>
# Vacío: las respuestas van al propio From (marketing@) que ya leemos por IMAP.
REPLY_TO=

# --- LECTURA de respuestas (IMAP de Gmail) ---
# Déjalo vacío para desactivar la detección automática (seguirá el botón manual "Respondió").
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=marketing@islassem.com
IMAP_PASSWORD=la-misma-contraseña-de-aplicación

# --- Formularios públicos ---
# Orígenes que pueden enviar formularios (separados por coma)
ALLOWED_ORIGINS=https://email-marketing.islassem.com,http://localhost:5173
# reCAPTCHA v3: clave SECRETA (google.com/recaptcha/admin). Vacío = sin verificación.
RECAPTCHA_SECRET=
# Puntuación mínima (0.0 bot … 1.0 humano)
RECAPTCHA_MIN_SCORE=0.5

# --- Correos entrantes ---
# true = un correo de un remitente desconocido crea un prospecto (como Bitrix).
# false (recomendado) = solo se registran respuestas y correos de contactos/prospectos existentes.
EMAIL_NEW_LEADS=false
