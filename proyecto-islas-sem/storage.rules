rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Ficheros de plantilla (source.zip, thumbnail.png), siempre con el uid en la ruta
    match /templates/{uid}/{templateId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás, bloqueado por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
